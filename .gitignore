# Root ignore for monorepo

# General
.env
.env.*
!.env.example
!**/.env.example
*.log
*.tmp
*.tsbuildinfo
.DS_Store
Thumbs.db
.vscode/
.idea/
.agent/
.agents/
.context/
.gemini/
.codex/
graphify-out/
AGENTS.md

# Nested git (avoid accidental submodule linkage)
api/.git/
web/.git/

# Backend (api)
api/node_modules/
api/dist/
api/coverage/
api/openapi.json
api/jest-cache/
api/jest-temp/

# Prisma
api/prisma/*.db
api/prisma/migrations/**/steps.json

# Frontend (web)
web/node_modules/
web/.next/
web/out/
web/build/
web/dist/
web/.turbo/

# Documentation outputs
documentation/.cache/
documentation/build/
