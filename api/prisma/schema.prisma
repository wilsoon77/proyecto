// Prisma schema for Panaderia Svetlana backend
// Redesigned to support: batch production (amasijos), combo pricing,
// raw material tracking with unit conversion, and multi-branch inventory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Use direct connection (no pooler) for migrations/introspection
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  BAKER
}

enum AssistantScope {
  ALL_BRANCHES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  CANCELLED
  PICKED_UP
}

enum PaymentMethod {
  EFECTIVO
}

// Origen del producto: producido internamente o comprado (abarrotes/reventa)
enum ProductOrigin {
  PRODUCIDO
  COMPRADO
}

// Unidades base normalizadas para inventario de materia prima
enum BaseUnit {
  LB // Libras (sólidos)
  ML // Mililitros (líquidos)
  UNIT // Unidades discretas (huevos, paquetes)
}

// Unidades de compra a proveedores (se convierten a BaseUnit en el backend)
enum UnitOfPurchase {
  // Sólidos → LB
  QUINTAL // 100 LB
  ARROBA // 25 LB
  LIBRA // 1 LB
  // Líquidos → ML
  LITRO // 1000 ML
  GALON // 3785 ML
  // Discretos → UNIT
  CARTON // 30 UNIT
  UNIDAD // 1 UNIT
}

// Tipos de movimiento de producto terminado (cantidad siempre positiva, tipo define operación)
enum StockMovementType {
  PRODUCCION // Suma (+) — salida de amasijo
  COMPRA // Suma (+) — productos de reventa
  VENTA // Resta (-)
  TRANSFERENCIA // Resta en A, Suma en B
  MERMA // Resta (-) conocida
  PERDIDA_ROBO // Resta (-) desconocida
  SOBRANTE // Suma (+) ajuste positivo
}

// Origen de un lote de producto terminado.
// TRANSFERENCIA permite conservar la fecha de caducidad al mover stock entre sucursales.
enum InventoryLotSource {
  PRODUCCION
  COMPRA
  TRANSFERENCIA
  SOBRANTE
  APERTURA
}

// ─────────────────────────────────────────────
// USUARIOS Y AUTENTICACIÓN
// ─────────────────────────────────────────────

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  // OAuth users do not have a local password. Password login rejects null explicitly.
  passwordHash       String?
  firstName          String
  lastName           String
  phone              String?             @db.VarChar(32)
  role               UserRole            @default(CUSTOMER)
  isActive           Boolean             @default(true)
  // Sucursal asignada (MANAGER, BAKER). MANAGER conserva una sucursal
  // predeterminada, pero su alcance operativo es global.
  branch             Branch?             @relation(fields: [branchId], references: [id])
  branchId           Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  stockMovements     StockMovement[]
  productionLogs     ProductionLog[]
  dailyCloses        DailyClose[]
  refreshTokens      RefreshToken[]
  trustedDevices     TrustedDevice[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  assistantAccess    AssistantAccess?
  telegramLink       TelegramLink?
  telegramLinkTokens TelegramLinkToken[]
}

model RefreshToken {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  hashedToken String @unique // SHA-256 del token opaco; fallback legacy en el servicio
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?   @db.VarChar(500)
  ipAddress   String?   @db.VarChar(45)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Dispositivos de confianza del usuario
model TrustedDevice {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  deviceId   String // Fingerprint del dispositivo
  name       String? // Nombre amigable (ej: "Chrome en Windows")
  userAgent  String?  @db.VarChar(500)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

// Intentos de login (para implementar captcha inteligente)
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String // Email intentado (puede no existir)
  ipAddress String   @db.VarChar(45)
  success   Boolean
  deviceId  String? // Fingerprint si está disponible
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ─────────────────────────────────────────────
// CATÁLOGO Y PRODUCTOS (Producto Terminado / Reventa)
// ─────────────────────────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
}

model Product {
  id                  Int              @id @default(autoincrement())
  sku                 String           @unique
  name                String
  slug                String           @unique
  description         String?
  // ── Precios ──
  basePrice           Decimal          @db.Decimal(10, 2) // Precio unitario (ej: Q0.50)
  // @deprecated Prefer ProductPresentation for every quantity-based sale.
  comboQuantity       Int? // Compatibilidad con catálogo legado (ej: 3 para "3x1.25")
  // @deprecated Prefer ProductPresentation.price for new configurations.
  comboPrice          Decimal?         @db.Decimal(10, 2) // Compatibilidad con catálogo legado
  stockUnitLabel      String           @default("unidades") // Nombre de la unidad física base (piezas, unidades, etc.)
  // ── Producción ──
  origin              ProductOrigin    @default(PRODUCIDO)
  unitsPerTray        Int? // Unidades por lata (ej: 36). Solo para PRODUCIDO.
  tracksExpiration    Boolean          @default(false) // Activa control de caducidad por lote
  // Días de anticipación para cada aviso de caducidad; solo se usa en COMPRADO.
  // Se ordena y normaliza en el servicio (ej. [30, 15, 3]).
  expirationAlertDays Int[]            @default([3])
  // ── Estado ──
  isNew               Boolean          @default(false)
  isActive            Boolean          @default(true)
  isAvailable         Boolean          @default(true)
  // ── Relaciones ──
  category            Category         @relation(fields: [categoryId], references: [id])
  categoryId          Int
  images              ProductImage[]
  recipes             Recipe[]
  inventories         Inventory[]
  orderItems          OrderItem[]
  stockMovements      StockMovement[]
  inventoryLots       InventoryLot[]
  dailyCloseItems     DailyCloseItem[]
  presentations       ProductPresentation[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // supabase-postgres-best-practices: indexes para queries frecuentes
  @@index([categoryId]) // Filtro por categoría (catálogo y operación)
  @@index([origin]) // Filtro PRODUCIDO vs COMPRADO
  @@index([isActive, isAvailable]) // Productos visibles y disponibles
}

// Presentación comercial/operativa de un producto.
// Ejemplos: "Media tira" = 3 piezas, "Tira completa" = 6 piezas.
// El inventario siempre se conserva en la unidad física base del producto.
model ProductPresentation {
  id             Int      @id @default(autoincrement())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      Int
  name           String
  unitsInStock   Int      // Piezas físicas que consume una presentación
  price          Decimal? @db.Decimal(10, 2)
  isForSale      Boolean  @default(true)
  isForProduction Boolean @default(false)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems     OrderItem[]
  productionLogs ProductionLog[]

  @@unique([productId, name])
  @@index([productId, isActive, isForSale])
  @@index([productId, isActive, isForProduction])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  url       String
  position  Int     @default(0)

  @@unique([productId, position])
}

// ─────────────────────────────────────────────
// MATERIA PRIMA
// ─────────────────────────────────────────────

// Materia prima (harina, levadura, manteca, etc.)
model RawMaterial {
  id                Int                    @id @default(autoincrement())
  name              String                 @unique
  baseUnit          BaseUnit // Unidad normalizada (LB, ML, UNIT)
  costPerUnit       Decimal                @db.Decimal(10, 4) // Costo promedio por unidad base
  minStock          Decimal?               @db.Decimal(10, 2) // Nivel mínimo para alerta
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  // Relaciones
  inventories       RawMaterialInventory[]
  recipeIngredients RecipeIngredient[]

  @@index([baseUnit])
}

// Inventario de materia prima por sucursal (siempre en unidad base)
model RawMaterialInventory {
  id            Int         @id @default(autoincrement())
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  rawMaterialId Int
  branch        Branch      @relation(fields: [branchId], references: [id])
  branchId      Int
  quantity      Decimal     @default(0) @db.Decimal(12, 4) // En unidad base (LB, ML, UNIT)
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@unique([rawMaterialId, branchId])
  @@index([branchId])
  @@index([rawMaterialId])
}

// ─────────────────────────────────────────────
// RECETAS Y PRODUCCIÓN (Amasijos / Latas)
// ─────────────────────────────────────────────

// Receta de un amasijo: define qué ingredientes se necesitan para producir un producto
model Recipe {
  id             Int                @id @default(autoincrement())
  product        Product            @relation(fields: [productId], references: [id])
  productId      Int
  name           String // Ej: "Amasijo Estándar de Francés"
  standardTrays  Int // Latas estándar esperadas por amasijo (ej: 33)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Relaciones
  ingredients    RecipeIngredient[]
  productionLogs ProductionLog[]

  @@index([productId])
  @@unique([productId, name])
}

// Ingrediente de una receta (cantidad por amasijo, en unidad base)
model RecipeIngredient {
  id            Int         @id @default(autoincrement())
  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      Int
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  rawMaterialId Int
  quantity      Decimal     @db.Decimal(10, 4) // Cantidad por amasijo en unidad base (ej: 50 LB)

  @@unique([recipeId, rawMaterialId])
}

// Registro de producción — evento inmutable de "se horneó un amasijo"
// Al crear un ProductionLog, el backend debe (en transacción):
//   1. RESTAR cada RecipeIngredient.quantity de RawMaterialInventory
//   2. SUMAR unitsProduced al Inventory del producto terminado
model ProductionLog {
  id             Int             @id @default(autoincrement())
  recipe         Recipe          @relation(fields: [recipeId], references: [id])
  recipeId       Int
  branch         Branch          @relation(fields: [branchId], references: [id])
  branchId       Int
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  traysProduced  Int // Latas reales producidas (ej: 33)
  unitsProduced  Int // Calculado: traysProduced × product.unitsPerTray (ej: 1188)
  presentationId       Int?
  presentation         ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  presentationName     String?
  presentationQuantity Int?
  presentationUnits    Int?
  note           String?
  createdAt      DateTime        @default(now())
  // Relaciones inversas
  stockMovements StockMovement[]

  @@index([recipeId])
  @@index([branchId])
  @@index([createdAt])
  @@index([presentationId])
}

// ─────────────────────────────────────────────
// INVENTARIO DE PRODUCTO TERMINADO
// ─────────────────────────────────────────────

// Inventario de producto terminado por sucursal (disponible = quantity - reserved)
model Inventory {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  Int
  quantity  Int      @default(0) // Unidades físicas
  reserved  Int      @default(0) // Comprometido (pedidos no retirados)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
}

// Lote de producto terminado. Inventory continúa siendo el resumen por producto/sucursal;
// este modelo conserva la fecha y el saldo de cada entrada para aplicar FEFO.
model InventoryLot {
  id                Int                       @id @default(autoincrement())
  product           Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         Int
  branch            Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId          Int
  sourceType        InventoryLotSource
  sourceMovement    StockMovement?            @relation("LotSourceMovement", fields: [sourceMovementId], references: [id], onDelete: SetNull)
  sourceMovementId  Int?
  initialQuantity   Int
  availableQuantity Int
  expiresAt         DateTime?
  alertAt           DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  consumptions      InventoryLotConsumption[]

  @@index([productId, branchId])
  @@index([branchId, expiresAt])
  @@index([productId, branchId, availableQuantity, expiresAt])
  @@index([sourceMovementId])
}

// Relación de consumo para auditar qué lotes se usaron en una venta, merma o transferencia.
model InventoryLotConsumption {
  id              Int           @id @default(autoincrement())
  lot             InventoryLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId           Int
  stockMovement   StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)
  stockMovementId Int
  quantity        Int
  createdAt       DateTime      @default(now())

  @@unique([lotId, stockMovementId])
  @@index([stockMovementId])
}

// Movimientos de inventario de producto terminado / reventa
model StockMovement {
  id              Int                       @id @default(autoincrement())
  product         Product                   @relation(fields: [productId], references: [id])
  productId       Int
  fromBranch      Branch?                   @relation("FromBranch", fields: [fromBranchId], references: [id])
  fromBranchId    Int?
  toBranch        Branch?                   @relation("ToBranch", fields: [toBranchId], references: [id])
  toBranchId      Int?
  type            StockMovementType
  quantity        Int
  // Vínculo opcional a producción (cuando type = PRODUCCION)
  productionLog   ProductionLog?            @relation(fields: [productionLogId], references: [id])
  productionLogId Int?
  // Caducidad para productos de reventa (type = COMPRA)
  expiresAt       DateTime?
  sourceLots      InventoryLot[]            @relation("LotSourceMovement")
  lotConsumptions InventoryLotConsumption[]
  user            User?                     @relation(fields: [userId], references: [id])
  userId          String?
  dailyClose      DailyClose?               @relation(fields: [dailyCloseId], references: [id], onDelete: SetNull)
  dailyCloseId    Int?
  referenceId     String?
  note            String?
  createdAt       DateTime                  @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([productionLogId])
  @@index([dailyCloseId])
}

// ─────────────────────────────────────────────
// SUCURSALES
// ─────────────────────────────────────────────

model Branch {
  id                     Int                    @id @default(autoincrement())
  name                   String
  slug                   String                 @unique
  address                String
  phone                  String?
  latitude               Float?
  longitude              Float?
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  // Relaciones
  inventories            Inventory[]
  rawMaterialInventories RawMaterialInventory[]
  inventoryLots          InventoryLot[]
  productionLogs         ProductionLog[]
  stockMovementsFrom     StockMovement[]        @relation("FromBranch")
  stockMovementsTo       StockMovement[]        @relation("ToBranch")
  orders                 Order[]
  employees              User[]
  dailyCloses            DailyClose[]
  alertStates            AlertState[]
}

// Documento auditable del inventario físico y las ventas no registradas de una jornada.
model DailyClose {
  id             Int              @id @default(autoincrement())
  branch         Branch           @relation(fields: [branchId], references: [id])
  branchId       Int
  user           User             @relation(fields: [userId], references: [id])
  userId         String
  closeDate      DateTime         @db.Date
  snapshotAt     DateTime
  note           String?
  items          DailyCloseItem[]
  stockMovements StockMovement[]
  createdAt      DateTime         @default(now())

  @@unique([branchId, closeDate])
  @@index([closeDate])
  @@index([branchId, createdAt])
}

model DailyCloseItem {
  id           Int        @id @default(autoincrement())
  dailyClose   DailyClose @relation(fields: [dailyCloseId], references: [id], onDelete: Cascade)
  dailyCloseId Int
  product      Product    @relation(fields: [productId], references: [id])
  productId    Int
  productName  String
  systemQty    Int
  reservedQty  Int
  countedQty   Int
  wasteQty     Int        @default(0)
  soldQty      Int        @default(0)
  surplusQty   Int        @default(0)

  @@unique([dailyCloseId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// PEDIDOS Y VENTAS
// ─────────────────────────────────────────────

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  // Se registra como efectivo por defecto; el cobro ocurre al retirar.
  paymentMethod PaymentMethod? @default(EFECTIVO)
  branch        Branch?     @relation(fields: [branchId], references: [id])
  branchId      Int?
  // Deadline for a PENDING pickup reservation.
  expiresAt     DateTime?
  customerNotes String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  // supabase-postgres-best-practices: indexes para queries frecuentes
  @@index([userId]) // Historial de pedidos del usuario
  @@index([status]) // Filtro por estado operativo
  @@index([status, expiresAt])
  @@index([branchId]) // Pedidos por sucursal
  @@index([createdAt]) // Ordenamiento cronológico
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  order       Order   @relation(fields: [orderId], references: [id])
  orderId     Int
  product     Product @relation(fields: [productId], references: [id])
  productId   Int
  productName String
  // Quantity requested by the customer (commercial units/presentations).
  quantity    Int
  // Physical units reserved/consumed from Inventory.
  stockQuantity Int
  unitPrice   Decimal @db.Decimal(10, 2)
  // Authoritative line amount, including legacy combo pricing.
  lineTotal   Decimal @db.Decimal(10, 2)
  presentationId       Int?
  presentation         ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  presentationName     String?
  presentationQuantity Int?
  presentationUnits    Int?

  @@index([orderId]) // JOIN con Order
  @@index([productId]) // Reportes por producto
  @@index([presentationId])
}

// ─────────────────────────────────────────────
// AUDITORÍA
// ─────────────────────────────────────────────

// Registro de auditoría para historial de cambios
model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  userName   String // Nombre del usuario al momento de la acción (por si se elimina)
  action     String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entity     String // Product, Order, User, Category, Branch, Inventory, etc.
  entityId   String? // ID del registro afectado
  entityName String? // Nombre descriptivo (ej: "Pan Francés", "Pedido #123")
  details    Json?    // Detalle estructurado, no JSON serializado dentro de TEXT
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// Configuración global del sistema (key-value tipado)
model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique // Clave única: 'store.name', 'orders.min_amount', etc.
  value       Json // Valor almacenado como JSON (string, number, boolean, object)
  type        String   @default("string") // Tipo de dato: 'string', 'number', 'boolean', 'json'
  category    String // Agrupación: 'STORE', 'ORDERS', 'OPERATIONS', 'APPEARANCE'
  label       String // Nombre legible: "Nombre de la tienda"
  description String? // Descripción para el admin
  isPublic    Boolean  @default(false) // Si es accesible sin autenticación (ej: nombre tienda, moneda)
  isReadOnly  Boolean  @default(false) // Si no es editable desde admin (ej: moneda, timezone)
  sortOrder   Int      @default(0) // Orden de presentación en el UI
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([isPublic])
}

// Configuración administrable de cada tipo de notificación
model NotificationConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique // 'inventory.raw_material_low', 'inventory.expiration_warning'
  name        String // Nombre de una alerta operativa
  description String?
  category    String // Actualmente solo 'INVENTORY'
  isEnabled   Boolean  @default(true)
  title       String // Título con placeholders de inventario
  message     String // Mensaje con placeholders de inventario
  targetRoles Json // ["ADMIN", "MANAGER"] — array de roles destino
  channels    Json? // ["IN_APP", "PUSH", "TELEGRAM"] — canales de despacho habilitados
  thresholds  Json? // { "threshold": 50, "unit": "LB" }
  soundType   String   @default("suave") // 'suave', 'alerta', 'importante'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isEnabled])
}

// Historial de notificaciones por usuario (in-app)
model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // Clave del NotificationConfig
  title     String
  message   String
  url       String? // Ruta de redirección operativa: inventario o caducidades
  icon      String? // Nombre de icono Lucide para la alerta
  isRead    Boolean   @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// Suscripciones push por dispositivo
model PushSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AssistantAccess {
  id        String         @id @default(cuid())
  userId    String         @unique
  enabled   Boolean        @default(true)
  scope     AssistantScope @default(ALL_BRANCHES)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLink {
  id         String    @id @default(cuid())
  userId     String    @unique
  chatId     String    @unique
  username   String?
  active     Boolean   @default(true)
  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TelegramUpdate {
  updateId    BigInt    @id
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model TelegramLinkAttempt {
  id          String   @id @default(cuid())
  chatId      String
  attemptedAt DateTime @default(now())
  reason      String?

  @@index([chatId, attemptedAt])
}

enum AlertType {
  RAW_MATERIAL_LOW
  PRODUCT_EXPIRY
}

model AlertState {
  id               String    @id @default(cuid())
  branchId         Int
  alertType        AlertType
  resourceKey      String
  active           Boolean   @default(false)
  firstTriggeredAt DateTime  @default(now())
  lastNotifiedAt   DateTime  @default(now())
  resolvedAt       DateTime?
  updatedAt        DateTime  @updatedAt
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, alertType, resourceKey])
  @@index([branchId, active])
}
