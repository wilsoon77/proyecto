# ===========================================
# VARIABLES DE ENTORNO - FRONTEND (Next.js)
# ===========================================
# Copia este archivo a .env.local para desarrollo
# En producción, configura estas variables en tu plataforma (Vercel, Railway, etc.)

# URL de la API backend
# Desarrollo: http://localhost:4000
# Producción: https://tu-api.ejemplo.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL privada que usan las rutas BFF/SSR de Next.js. Si no se define se usa
# NEXT_PUBLIC_API_URL; en producción puede apuntar al dominio interno de la API.
API_INTERNAL_URL=http://localhost:4000

# URL pública canónica, sin slash final. En Vercel usa tu dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME="Panadería Svetlana"

# Entorno (development | production)
NEXT_PUBLIC_APP_ENV=development

# ===========================================
# SUPABASE (OAuth - Google, GitHub)
# ===========================================
# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key (pública, segura para frontend)
# Encontrar en: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Google Maps API Key (opcional, para mapas de sucursales)
# Obtener en: https://console.cloud.google.com (habilitar Maps Embed API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ===========================================
# hCAPTCHA (Protección contra bots)
# ===========================================
# Sitekey de hCaptcha (pública, segura para frontend)
# Obtener en: https://dashboard.hcaptcha.com
# 1. Crear cuenta en https://www.hcaptcha.com
# 2. Crear un nuevo sitio y agregar tus dominios (localhost, tu-dominio.com)
# 3. Copiar el Sitekey aquí
# 4. Copiar el Secret Key y agregarlo en Supabase Dashboard → Auth → Attack Protection
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# DSN de Sentry para la web (opcional; un DSN es público). No habilita el envío de PII.
NEXT_PUBLIC_SENTRY_DSN=

# Analytics (opcional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
