# ===========================================
# VARIABLES DE ENTORNO - BACKEND (NestJS)
# ===========================================
# Copia este archivo a .env para desarrollo
# En producción, configura estas variables en tu plataforma (Railway, Render, etc.)

# ===========================================
# BASE DE DATOS (PostgreSQL)
# ===========================================
# URL de conexión pooled (para runtime de la app)
# Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=public"

# URL directa (para migraciones de Prisma)
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# ===========================================
# AUTENTICACIÓN (JWT)
# ===========================================
# ⚠️ Obligatorio: usar secretos aleatorios de 32+ caracteres, también fuera de producción
# Generar con: openssl rand -base64 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Tiempo de expiración de tokens (opcional)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# SERVIDOR
# ===========================================
# Puerto del servidor
PORT=4000

# Orígenes permitidos para CORS (separados por coma)
# Desarrollo: http://localhost:3000
# Producción: https://tu-frontend.ejemplo.com
CORS_ORIGINS="http://localhost:3000"

# Entorno (development | production)
NODE_ENV=development

# Número de proxies confiables. En Render debe ser 1; en desarrollo local puede ser 0.
TRUST_PROXY_HOPS=0

# Observabilidad (opcional). El DSN no se deja embebido en el código.
SENTRY_DSN=

# ===========================================
# SUPABASE AUTH (Opcional - para OAuth)
# ===========================================
# URL de tu proyecto Supabase (https://[PROJECT_REF].supabase.co)
SUPABASE_URL="https://tu-proyecto.supabase.co"

# Service Role Key (encontrar en Settings > API)
# ⚠️ NUNCA exponer esta clave en el frontend
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_secreta"

# ===========================================
# hCAPTCHA (verificación del lado servidor)
# ===========================================
# Secret Key privada de hCaptcha. Nunca usar NEXT_PUBLIC_ ni exponerla al navegador.
HCAPTCHA_SECRET=
# Lista opcional de dominios esperados, separada por coma (ej.: localhost,tu-dominio.com).
HCAPTCHA_ALLOWED_HOSTNAMES=localhost

# ===========================================
# APPWRITE (Almacenamiento de Imágenes)
# ===========================================
# Endpoint de tu proyecto Appwrite
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"

# ID de tu proyecto en Appwrite
APPWRITE_PROJECT_ID="tu_project_id"

# API Key con permisos de Storage (files.read, files.write)
APPWRITE_API_KEY="tu_api_key_secreta"

# ID del bucket para imágenes de productos
APPWRITE_BUCKET_ID="product-images"

# ===========================================
# NOTIFICACIONES PUSH (VAPID)
# ===========================================
VAPID_PUBLIC_KEY="tu_vapid_public_key"
VAPID_PRIVATE_KEY="tu_vapid_private_key"
VAPID_SUBJECT="mailto:soporte@tudominio.com"


