# Root ignore for monorepo

# General
.env
.env.*
!.env.example
!**/.env.example
*.log
*.tmp
*.tsbuildinfo
.DS_Store
Thumbs.db
.vscode/
.idea/
.agent/
.agents/
.context/
.gemini/
.codex/
graphify-out/
AGENTS.md
scratch/

# Nested git (avoid accidental submodule linkage)
api/.git/
web/.git/

# Backend (api)
api/node_modules/
api/dist/
api/coverage/
api/openapi.json
api/jest-cache/
api/jest-temp/
api/test-*.txt

# Prisma
api/prisma/*.db
api/prisma/migrations/**/steps.json

# Frontend (web)
web/node_modules/
web/.next/
web/out/
web/build/
web/dist/
web/.turbo/
web/audit-results/
audit-results/
web/playwright-report/
web/test-results/
api/benchmark_*.json
api/scripts/benchmark_*.mjs
api/scripts/measure_*.mjs
api/scripts/query_*.mjs
api/scripts/test_*.mjs
web/scripts/run-responsiveness-audit.mjs
web/scripts/test-local-auth.mjs

# Documentation outputs
documentation/.cache/
documentation/build/
__pycache__/
*.py[cod]

# Local seeds
api/scripts/local_seeds/
